FROM caddy:2.10.2 AS caddy

FROM julia:1.12.6-bookworm AS build

ENV JULIA_DEPOT_PATH=/opt/julia-depot \
    JULIA_PKG_PRECOMPILE_AUTO=0
WORKDIR /app

COPY Project.toml ./
COPY src ./src
COPY ext ./ext
COPY examples/Project.toml ./examples/Project.toml
COPY examples/states_rest_server/Project.toml ./examples/states_rest_server/Project.toml

RUN julia --startup-file=no --threads=auto --project=examples -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()' && \
    julia --startup-file=no --threads=auto --project=examples/states_rest_server -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'

COPY examples/firstgenrepeater/setup.jl examples/firstgenrepeater/2_swapper_example.jl ./examples/firstgenrepeater/
COPY examples/colorcentermodularcluster/setup.jl examples/colorcentermodularcluster/3_makie_interactive.jl ./examples/colorcentermodularcluster/
COPY examples/congestionchain/setup.jl examples/congestionchain/2_makie_interactive.jl ./examples/congestionchain/
COPY examples/simpleswitch/setup.jl examples/simpleswitch/2_wglmakie_interactive.jl ./examples/simpleswitch/
COPY examples/repeatergrid/setup.jl examples/repeatergrid/1b_async_wglmakie_interactive.jl examples/repeatergrid/2b_sync_wglmakie_interactive.jl ./examples/repeatergrid/
COPY examples/state_explorer/state_explorer.jl ./examples/state_explorer/
COPY examples/states_rest_server/server.jl ./examples/states_rest_server/
COPY examples/areweentangledyet/start.sh ./examples/areweentangledyet/start.sh
COPY examples/areweentangledyet/public ./examples/areweentangledyet/public

FROM julia:1.12.6-bookworm

ENV JULIA_DEPOT_PATH=/opt/julia-depot \
    JULIA_PKG_OFFLINE=true \
    JULIA_PKG_PRECOMPILE_AUTO=0

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl jq xvfb && \
    rm -rf /var/lib/apt/lists/*

COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
COPY --from=build /opt/julia-depot /opt/julia-depot
COPY --from=build /app /app

WORKDIR /app
RUN /app/examples/areweentangledyet/start.sh --validate-only

EXPOSE 8000
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/examples/areweentangledyet/start.sh"]
